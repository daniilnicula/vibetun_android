<Window x:Class="GoreBox.Views.Dialogs.CloseDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Закрыть" Width="400" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBg}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
    <Border BorderBrush="{DynamicResource Divider}" BorderThickness="1" CornerRadius="10"
            Background="{DynamicResource WindowBg}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" MouseLeftButtonDown="OnDrag">
            <TextBlock Text="Скрыть или выйти из приложения?" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}" Margin="18,0,0,0" VerticalAlignment="Center" />
        </Border>

        <StackPanel Grid.Row="1" Margin="18,0,18,4">
            <CheckBox x:Name="RememberBox" Style="{StaticResource Check}" Content="Запомнить мой выбор"
                      Foreground="{DynamicResource TextSecondary}" VerticalContentAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="18,14,18,16">
            <Button Content="Закрыть" Style="{StaticResource BtnGhost}" Click="OnExit" />
            <Button Content="Скрыть" Style="{StaticResource BtnPrimary}" Margin="8,0,0,0" Click="OnHide" IsDefault="True" />
        </StackPanel>
    </Grid>
    </Border>
</Window>
